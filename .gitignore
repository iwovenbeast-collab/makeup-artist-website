# Environment files and secrets
.env
.env.*
!.env.example

# Operating system files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node dependencies and build output
frontend-react/node_modules/
frontend-react/dist/

# PHP dependencies
backend/rupanjali-api/vendor/

# CodeIgniter writable files
backend/rupanjali-api/writable/cache/*
backend/rupanjali-api/writable/debugbar/*
backend/rupanjali-api/writable/logs/*
backend/rupanjali-api/writable/session/*
backend/rupanjali-api/writable/uploads/*
backend/rupanjali-api/writable/cache/*
backend/rupanjali-api/writable/debugbar/*
backend/rupanjali-api/writable/logs/*
