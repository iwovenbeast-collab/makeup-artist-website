# Ignore runtime uploads but preserve upload directories
backend/rupanjali-api/public/uploads/*
!backend/rupanjali-api/public/uploads/.gitkeep

# Local database dumps
*.sql
*.sql.gz

# Temporary backups
*.backup
*.bak
*.tmp
